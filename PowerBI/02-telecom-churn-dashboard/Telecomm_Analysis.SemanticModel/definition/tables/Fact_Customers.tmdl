		lineageTag: 0925fdeb-5f1a-4d47-a430-9cf845ea65a1
		sourceColumn: tenure

	column MonthlyCharges
		dataType: double
		lineageTag: 0cf8a768-c3c4-4f5c-8e80-e63616b410df
		summarizeBy: sum
		sourceColumn: MonthlyCharges

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column TotalCharges
		dataType: string
		lineageTag: 58eb36dd-fb49-4004-b509-7cbd5e736f3f
		summarizeBy: none
		sourceColumn: TotalCharges

		annotation SummarizationSetBy = Automatic

