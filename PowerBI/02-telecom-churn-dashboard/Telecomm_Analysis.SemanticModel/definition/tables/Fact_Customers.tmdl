	column 'Has Premium Services'
		dataType: string
		lineageTag: fef0f9c7-8bca-4c97-8426-87c4aa31d4ad
		sourceColumn: Has Premium Services

	/// Senior / Non-Senior label for SeniorCitizen flag
	column 'Senior Citizen Status' = IF( Fact_Customers[SeniorCitizen] = 1, "Senior", "Non-Senior" )
		dataType: string
		lineageTag: 0207a950-45d5-4d40-a6b7-f4eefaa1abe7

	/// Senior status x partner x dependents profile
	column 'Customer Profile' = Fact_Customers[Senior Citizen Status] & " | " & IF( Fact_Customers[Partner] = "Yes", "Partner", "No partner" ) & " | " & IF( Fact_Customers[Dependents] = "Yes", "Dependents", "No dependents" )
		dataType: string
		lineageTag: 5e4f3b53-7b99-48d7-b2ea-b039300f74ac

	column 'Security Bundle' = SWITCH( TRUE(), Fact_Customers[OnlineSecurity] = "No internet service", "No internet", Fact_Customers[OnlineSecurity] = "Yes" && Fact_Customers[TechSupport] = "Yes", "Security + Tech Support", Fact_Customers[OnlineSecurity] = "Yes", "Security only", Fact_Customers[TechSupport] = "Yes", "Tech Support only", "No protection" )
		dataType: string
		lineageTag: 70d066fb-be4d-4541-84ad-c9cb3b9fa1e9

	column 'Streaming Bundle' = SWITCH( TRUE(), Fact_Customers[StreamingTV] = "No internet service", "No internet", Fact_Customers[StreamingTV] = "Yes" && Fact_Customers[StreamingMovies] = "Yes", "TV + Movies", Fact_Customers[StreamingTV] = "Yes", "TV only", Fact_Customers[StreamingMovies] = "Yes", "Movies only", "No streaming" )
		dataType: string
		lineageTag: fe138438-68d3-4786-9b72-d5d100a701aa

	partition Fact_Customers = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\Users\pragh\data-analytics-portfolio\PowerBI\02-telecom-churn-dashboard\data\WA_Fn-UseC_-Telco-Customer-Churn.csv"), [Delimiter = ",", Columns = 21, QuoteStyle = QuoteStyle.None]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {{"customerID", type text}, {"gender", type text}, {"SeniorCitizen", Int64.Type}, {"Partner", type text}, {"Dependents", type text}, {"tenure", Int64.Type}, {"PhoneService", type text}, {"MultipleLines", type text}, {"InternetService", type text}, {"OnlineSecurity", type text}, {"OnlineBackup", type text}, {"DeviceProtection", type text}, {"TechSupport", type text}, {"StreamingTV", type text}, {"StreamingMovies", type text}, {"Contract", type text}, {"PaperlessBilling", type text}, {"PaymentMethod", type text}, {"MonthlyCharges", type number}, {"TotalCharges", type number}, {"Churn", type text}}, "en-US"),
				    #"Replace TotalCharges Nulls" = Table.ReplaceValue(#"Changed Type", null, each [MonthlyCharges] * [tenure], Replacer.ReplaceValue, {"TotalCharges"}),
				    #"Clean Service Columns" = Table.TransformColumns(#"Replace TotalCharges Nulls", {{"OnlineSecurity", each if _ = "No internet service" then "No" else _, type text}, {"OnlineBackup", each if _ = "No internet service" then "No" else _, type text}, {"DeviceProtection", each if _ = "No internet service" then "No" else _, type text}, {"TechSupport", each if _ = "No internet service" then "No" else _, type text}, {"StreamingTV", each if _ = "No internet service" then "No" else _, type text}, {"StreamingMovies", each if _ = "No internet service" then "No" else _, type text}, {"MultipleLines", each if _ = "No phone service" then "No" else _, type text}}),
				    #"Add Is Churned" = Table.AddColumn(#"Clean Service Columns", "Is Churned", each if [Churn] = "Yes" then 1 else 0, Int64.Type),
				    #"Add Tenure Band Key" = Table.AddColumn(#"Add Is Churned", "Tenure Band Key", each if [tenure] <= 12 then 1 else if [tenure] <= 24 then 2 else if [tenure] <= 36 then 3 else if [tenure] <= 48 then 4 else if [tenure] <= 60 then 5 else 6, Int64.Type),
				    #"Add Contract Key" = Table.AddColumn(#"Add Tenure Band Key", "Contract Key", each if [Contract] = "Month-to-month" then 1 else if [Contract] = "One year" then 2 else 3, Int64.Type),
				    #"Add Payment Key" = Table.AddColumn(#"Add Contract Key", "Payment Key", each if [PaymentMethod] = "Electronic check" then 1 else if [PaymentMethod] = "Mailed check" then 2 else if [PaymentMethod] = "Bank transfer (automatic)" then 3 else 4, Int64.Type),
				    #"Add Internet Key" = Table.AddColumn(#"Add Payment Key", "Internet Key", each if [InternetService] = "DSL" then 1 else if [InternetService] = "Fiber optic" then 2 else 3, Int64.Type),
				    #"Add Service Count" = Table.AddColumn(#"Add Internet Key", "Service Count", each List.Count(List.Select({[PhoneService], [MultipleLines], [OnlineSecurity], [OnlineBackup], [DeviceProtection], [TechSupport], [StreamingTV], [StreamingMovies]}, each _ = "Yes")), Int64.Type),
				    #"Add Has Premium Services" = Table.AddColumn(#"Add Service Count", "Has Premium Services", each if [OnlineSecurity] = "Yes" or [TechSupport] = "Yes" then "Yes" else "No", type text),
				    #"Add Customer Key" = Table.AddIndexColumn(#"Add Has Premium Services", "Customer Key", 1, 1, Int64.Type),
				    #"Reorder Columns" = Table.SelectColumns(#"Add Customer Key", {"Customer Key", "customerID", "Contract Key", "Payment Key", "Internet Key", "Tenure Band Key", "tenure", "MonthlyCharges", "TotalCharges", "PhoneService", "MultipleLines", "OnlineSecurity", "OnlineBackup", "DeviceProtection", "TechSupport", "StreamingTV", "StreamingMovies", "PaperlessBilling", "Churn", "Is Churned", "gender", "SeniorCitizen", "Partner", "Dependents", "Service Count", "Has Premium Services"})
				in
				    #"Reorder Columns"

	annotation PBI_ResultType = Table

