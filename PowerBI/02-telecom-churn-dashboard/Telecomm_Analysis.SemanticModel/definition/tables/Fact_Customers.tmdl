table Fact_Customers
	lineageTag: e391d52c-b790-4b7a-9ec6-4a4534e08982

	/// Total number of customers
	measure 'Total Customers' = COUNTROWS( Fact_Customers )
		formatString: #,0
		lineageTag: a5b39dcc-e0b0-473a-a14f-76914c7640bc

	/// Number of churned customers
	measure 'Total Churned' = SUM( Fact_Customers[Is Churned] )
		formatString: #,0
		lineageTag: 8b3a5800-4065-4da3-a2cb-dd4e0aed890f

	/// Churned / Total × 100
	measure 'Churn Rate %' = DIVIDE( [Total Churned], [Total Customers] )
		formatString: 0.0%
		lineageTag: 7b8030e8-a3a1-4d82-9567-6f6278a4a805

	/// Number of retained customers
	measure 'Retained Customers' = [Total Customers] - [Total Churned]
		formatString: #,0
		lineageTag: 02193b48-d717-4b91-8d8c-aa30d6b98a85

	/// Sum of monthly charges for churned customers
	measure 'Revenue at Risk' = CALCULATE( SUM( Fact_Customers[MonthlyCharges] ), Fact_Customers[Churn] = "Yes" )
		formatString: $#,0.00
		lineageTag: 60da6bea-bc70-40aa-8bc9-a266ef4de81b

	/// Average monthly charge for churned customers
	measure 'Avg Monthly Charge (Churners)' = CALCULATE( AVERAGE( Fact_Customers[MonthlyCharges] ), Fact_Customers[Churn] = "Yes" )
		formatString: $#,0.00
		lineageTag: f2fa417e-5b91-41fe-a56f-67cb3c9d57ea

	/// Average tenure in months for churned customers
	measure 'Avg Tenure (Churners)' = CALCULATE( AVERAGE( Fact_Customers[tenure] ), Fact_Customers[Churn] = "Yes" )
		formatString: 0.0
		lineageTag: e3785dfb-6777-4867-a734-e4387779a834

	/// Average tenure in months for retained customers
	measure 'Avg Tenure (Retained)' = CALCULATE( AVERAGE( Fact_Customers[tenure] ), Fact_Customers[Churn] = "No" )
		formatString: 0.0
		lineageTag: be9bf297-35d9-4b83-a7ca-7f05e1bb8d14

	/// Churn rate among senior citizens
	measure 'Senior Citizen Churn Rate %' =
			DIVIDE(
			    CALCULATE( [Total Churned], Fact_Customers[SeniorCitizen] = 1 ),
			    CALCULATE( [Total Customers], Fact_Customers[SeniorCitizen] = 1 )
			)
		formatString: 0.0%
		lineageTag: 02938167-2756-4fff-a951-4aec686dd1f6

	/// Churn rate for month-to-month contract customers
	measure 'MTM Churn Rate %' =
			DIVIDE(
			    CALCULATE( [Total Churned], Dim_Contract[Contract] = "Month-to-month" ),
			    CALCULATE( [Total Customers], Dim_Contract[Contract] = "Month-to-month" )
			)
		formatString: 0.0%
		lineageTag: d1c8d9ee-cbf6-4192-ba7d-f4f21477b589

	/// Churn rate for fiber optic internet customers
	measure 'Fiber Optic Churn Rate %' =
			DIVIDE(
			    CALCULATE( [Total Churned], Dim_InternetService[InternetService] = "Fiber optic" ),
			    CALCULATE( [Total Customers], Dim_InternetService[InternetService] = "Fiber optic" )
			)
		formatString: 0.0%
		lineageTag: 9306378e-c509-4f87-9993-9517b3916263

	/// Sum of monthly charges, all customers
	measure 'Total Monthly Revenue' = SUM( Fact_Customers[MonthlyCharges] )
		formatString: $#,0
		lineageTag: 16db2326-707a-46f0-adb6-324511238b5d

	/// Monthly charges from retained customers
	measure 'Retained Monthly Revenue' = [Total Monthly Revenue] - [Revenue at Risk]
		formatString: $#,0
		lineageTag: faecb8a3-58cd-4bb5-9494-a45f898e2f8e

	/// Share of monthly revenue lost to churn
	measure 'Revenue at Risk %' = DIVIDE( [Revenue at Risk], [Total Monthly Revenue] )
		formatString: 0.0%
		lineageTag: b23039b4-d2d7-4a5e-a16c-70f4f9a343db

	/// Monthly revenue at risk x 12
	measure 'Annualized Revenue at Risk' = [Revenue at Risk] * 12
		formatString: $#,0
		lineageTag: 267c1029-8e26-4cd4-94c9-da68ff69785e

	/// Average monthly charge, retained customers
	measure 'Avg Monthly Charge (Retained)' = CALCULATE( AVERAGE( Fact_Customers[MonthlyCharges] ), Fact_Customers[Churn] = "No" )
		formatString: $#,0.00
		lineageTag: 9cdd27a2-dee5-40df-ac4e-12668ce7ab9f

	/// Segment contribution to total revenue at risk
	measure 'Share of Revenue at Risk %' = DIVIDE( [Revenue at Risk], CALCULATE( [Revenue at Risk], ALLSELECTED() ) )
		formatString: 0.0%
		lineageTag: c27e159a-1786-4e88-9e28-86507ceb73d8

	/// Waterfall values: total monthly revenue, then churned revenue by contract (negative)
	measure 'Revenue Bridge Value' = SWITCH( SELECTEDVALUE( Revenue_Bridge[Step] ), "Total Monthly Revenue", [Total Monthly Revenue], "Month-to-month churn", -CALCULATE( [Revenue at Risk], KEEPFILTERS( Dim_Contract[Contract] = "Month-to-month" ) ), "One-year churn", -CALCULATE( [Revenue at Risk], KEEPFILTERS( Dim_Contract[Contract] = "One year" ) ), "Two-year churn", -CALCULATE( [Revenue at Risk], KEEPFILTERS( Dim_Contract[Contract] = "Two year" ) ) )
		formatString: $#,0
		lineageTag: 0859268c-7d72-427e-a11d-96805cc45e26

	/// What-if assumption (default 20% when nothing selected)
	measure 'Success Rate Assumption' = SELECTEDVALUE( Param_Success_Rate[Success Rate], 0.2 )
		formatString: 0%
		lineageTag: ad24fed8-783e-480a-9bee-e8db79e11521

	/// What-if assumption (default $50)
	measure 'Cost per Customer Assumption' = SELECTEDVALUE( Param_Cost_per_Customer[Cost per Targeted Customer], 50 )
		formatString: $#,0
		lineageTag: 7fced0e3-62c0-4530-8a3d-93ef2db05b91

	/// What-if assumption (default 100%)
	measure 'Coverage Assumption' = SELECTEDVALUE( Param_Coverage[Coverage], 1 )
		formatString: 0%
		lineageTag: 77c073b6-81cd-4c15-92e8-2e0481f46da6

	/// What-if assumption (default 12 months)
	measure 'Horizon Assumption' = SELECTEDVALUE( Param_Horizon[Horizon (Months)], 12 )
		formatString: 0
		lineageTag: dcf8b4ba-b318-46f4-ad30-529ec45e393b

	/// Churn-exposed customers included in the retention program
	measure 'Customers Targeted' = [Total Churned] * [Coverage Assumption]
		formatString: #,0
		lineageTag: 4245323a-4cc5-463c-b58f-9853527f220a

	/// Targeted customers x cost per customer
	measure 'Retention Cost (Est.)' = [Customers Targeted] * [Cost per Customer Assumption]
		formatString: $#,0
		lineageTag: 89a6ae3a-180f-4ba8-9003-df829f492be9

	/// Targeted customers x success rate
	measure 'Customers Retained (Est.)' = [Customers Targeted] * [Success Rate Assumption]
		formatString: #,0
		lineageTag: b1eca452-2dae-4f77-bbd3-bef59345aa4a

	/// Monthly revenue at risk x coverage x success x horizon months
	measure 'Revenue Retained (Est.)' = [Revenue at Risk] * [Coverage Assumption] * [Success Rate Assumption] * [Horizon Assumption]
		formatString: $#,0
		lineageTag: b0e08e60-0660-4dd3-85a2-85d104f3fdee

	/// Revenue retained less retention cost
	measure 'Net Benefit (Est.)' = [Revenue Retained (Est.)] - [Retention Cost (Est.)]
		formatString: $#,0;-$#,0
		lineageTag: 85f21883-fce3-4d00-8515-ff86dbac2631

	/// Net benefit / retention cost
	measure 'Retention ROI (Est.)' = DIVIDE( [Net Benefit (Est.)], [Retention Cost (Est.)] )
		formatString: 0%;-0%
		lineageTag: d2fd64dd-2eee-475c-b964-975bfef935a8

	/// Text summary of active what-if assumptions
	measure 'Assumptions Used' = "Success " & FORMAT( [Success Rate Assumption], "0%" ) & " | Cost $" & FORMAT( [Cost per Customer Assumption], "#,0" ) & " | Coverage " & FORMAT( [Coverage Assumption], "0%" ) & " | " & [Horizon Assumption] & " months"
		lineageTag: 6b3d10a0-2469-402a-833f-93072970d96b

	column 'Customer Key'
		dataType: int64
		isHidden
		lineageTag: 150b9fef-7a94-43fe-938a-54cf85719a74
		sourceColumn: Customer Key

