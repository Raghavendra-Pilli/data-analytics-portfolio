			lineageTag: ba0e0397-2a7c-440a-ae2e-1829b7d43940
			column: Date

	partition Dim_Date = calculated
		mode: import
		source =
				VAR _FirstOrderDate = MIN ( 'Sample - Superstore'[Order Date] )
				VAR _LastOrderDate  = MAX ( 'Sample - Superstore'[Order Date] )
				VAR _LastAnyDate    = MAX ( _LastOrderDate, MAX ( 'Sample - Superstore'[Ship Date] ) )
				VAR _FYStartMonth   = 4    -- Fiscal year start month (4 = April)
				VAR _Base = CALENDAR ( DATE ( YEAR ( _FirstOrderDate ), 1, 1 ), DATE ( YEAR ( _LastAnyDate ), 12, 31 ) )
				RETURN
				GENERATE ( _Base,
				  VAR d   = [Date]
				  VAR y   = YEAR ( d )
				  VAR m   = MONTH ( d )
				  VAR q   = QUARTER ( d )
				  VAR dow = WEEKDAY ( d, 2 )                 -- Monday = 1
				  VAR isoYear = YEAR ( d - dow + 4 )         -- year of the week's Thursday
				  VAR isoWeek = WEEKNUM ( d, 21 )
				  VAR fyStart = IF ( m >= _FYStartMonth, y, y - 1 )
				  VAR fm  = MOD ( m - _FYStartMonth, 12 ) + 1
				  VAR fq  = INT ( ( fm - 1 ) / 3 ) + 1
				  VAR fyLabel = "FY" & fyStart & "-" & RIGHT ( fyStart + 1, 2 )
				  RETURN ROW (
				    "Date Key", y * 10000 + m * 100 + DAY ( d ),
				    "Year", y,
				    "Quarter Number", q,
				    "Quarter", "Q" & q,
				    "Year Quarter", y & "-Q" & q,
				    "Year Quarter Key", y * 10 + q,
				    "Month Number", m,
				    "Month Name", FORMAT ( d, "mmmm" ),
				    "Month Short", FORMAT ( d, "mmm" ),
				    "Year-Month", FORMAT ( d, "yyyy-mm" ),
				    "Month Year", FORMAT ( d, "mmm yyyy" ),
				    "Year Month Key", y * 100 + m,
				    "Month Start", DATE ( y, m, 1 ),
				    "Month End", EOMONTH ( d, 0 ),
				    "ISO Year", isoYear,
				    "ISO Week", isoWeek,
				    "Year Week", isoYear & "-W" & FORMAT ( isoWeek, "00" ),
				    "Year Week Key", isoYear * 100 + isoWeek,
				    "Week Start", d - dow + 1,
				    "Day", DAY ( d ),
				    "Day of Week Number", dow,
				    "Day Name", FORMAT ( d, "dddd" ),
				    "Day Short", FORMAT ( d, "ddd" ),
				    "Day of Year", INT ( d - DATE ( y, 1, 1 ) ) + 1,
				    "Is Weekend", dow >= 6,
				    "Fiscal Year", fyLabel,
				    "Fiscal Year Start", fyStart,
				    "Fiscal Quarter Number", fq,
				    "Fiscal Quarter", "FQ" & fq,
				    "Fiscal Year Quarter", fyLabel & " FQ" & fq,
				    "Fiscal Year Quarter Key", fyStart * 10 + fq,
				    "Fiscal Month Number", fm,
				    "Is Order Period", d >= _FirstOrderDate && d <= _LastOrderDate,
				    "Is Future", d > _LastOrderDate,
				    "Is YTD Comparable", m * 100 + DAY ( d ) <= MONTH ( _LastOrderDate ) * 100 + DAY ( _LastOrderDate ),
				    "Year Offset", y - YEAR ( _LastOrderDate ),
				    "Quarter Offset", ( y - YEAR ( _LastOrderDate ) ) * 4 + q - QUARTER ( _LastOrderDate ),
				    "Month Offset", ( y - YEAR ( _LastOrderDate ) ) * 12 + m - MONTH ( _LastOrderDate ),
				    "Day Offset", INT ( d - _LastOrderDate )
				  )
				)

