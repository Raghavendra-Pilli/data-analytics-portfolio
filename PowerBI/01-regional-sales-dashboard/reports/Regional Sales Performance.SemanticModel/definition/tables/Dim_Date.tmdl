	hierarchy 'Fiscal Hierarchy'
		lineageTag: 80c0203c-5314-4a16-adde-3de81bcd918d

		level 'Fiscal Year'
			lineageTag: eefee828-dfa1-45e1-bb89-f3b35ffdea92
			column: 'Fiscal Year'

		level 'Fiscal Quarter'
			lineageTag: f04d5474-54ca-4c38-b2e4-65c97f09cc8a
			column: 'Fiscal Quarter'

