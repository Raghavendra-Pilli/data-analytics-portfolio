model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-IN
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["stg_Superstore","Sample - Superstore","DimCustomer"]

annotation PBI_ProTooling = ["MCP-PBIModeling","DevMode"]

ref table 'Sample - Superstore'
ref table Dim_Date
ref table DimCustomer
ref table _Measures
ref table 'Min Orders'
ref table 'State Grid'

ref cultureInfo en-US

